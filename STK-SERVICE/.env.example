# Never commit your real .env or share these values.
DARAJA_ENV=production
DARAJA_CONSUMER_KEY=replace_me
DARAJA_CONSUMER_SECRET=replace_me
DARAJA_SHORTCODE=replace_with_daraja_business_shortcode
DARAJA_PASSKEY=replace_me
DARAJA_TILL_NUMBER=replace_with_your_till_number
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
# Generate a long random value; required to call POST /api/stk-push.
STK_API_KEY=replace_with_long_random_secret
