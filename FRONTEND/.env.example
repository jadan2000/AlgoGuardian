# Environment Configuration for Multiple Bots
# Change VITE_API_URL to point to different backend ports

# Bot A Backend Port 8001
# VITE_API_URL=http://${API_BASE}

# Bot B Backend Port 8001
# VITE_API_URL=http://${API_BASE}

# Bot C Backend Port 8002
# VITE_API_URL=http://localhost:8002

# Set your active backend URL here
VITE_API_URL=http://${API_BASE}

# Supabase Auth (frontend-safe publishable/anon key only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
