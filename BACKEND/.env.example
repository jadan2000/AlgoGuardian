# Copy this file to .env and enter credentials for a DEMO account only.
# Never commit .env or share its contents.
MT5_LOGIN=12345678
MT5_PASSWORD=replace_with_demo_trading_password
MT5_SERVER=YourBroker-Demo
# Optional absolute path to terminal64.exe. Leave blank to use the default terminal.
MT5_PATH=


# Supabase backend access (service-role key is secret; NEVER put it in frontend env)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Safaricom Daraja M-Pesa STK Push. Start with sandbox.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=YOUR_DARAJA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_DARAJA_CONSUMER_SECRET
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=YOUR_DARAJA_PASSKEY
# Must be a public HTTPS URL pointing to POST /api/payments/callback
MPESA_CALLBACK_URL=https://YOUR-PUBLIC-BACKEND-DOMAIN/api/payments/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
