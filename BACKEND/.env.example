# Copy this file to .env and never commit or share it.
# Optional absolute path to terminal64.exe. Leave blank to use the default terminal.
MT5_PATH=
# Required encryption key for broker credentials saved through the Accounts page.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key stable and private; changing it makes previously saved credentials unreadable.
MT5_CREDENTIALS_ENCRYPTION_KEY=replace_with_generated_fernet_key
# Restrict Accounts management to your registered Supabase email or user ID.
MT5_ACCOUNT_ADMIN_EMAIL=your-login-email@example.com
# Alternatively use MT5_ACCOUNT_ADMIN_USER_ID and leave the email unset.


# Frontend origins, comma-separated (include your deployed Vercel URL when available)
FRONTEND_ORIGINS=https://YOUR-FRONTEND-DOMAIN.vercel.app

# Supabase backend access (service-role key is secret; NEVER put it in frontend env)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Safaricom Daraja M-Pesa STK Push. Start with sandbox.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=YOUR_DARAJA_CONSUMER_KEY
DARAJA_CONSUMER_SECRET=YOUR_DARAJA_CONSUMER_SECRET
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=YOUR_DARAJA_PASSKEY
# Required for CustomerBuyGoodsOnline (use the till number for your Daraja setup)
DARAJA_TILL_NUMBER=YOUR_DARAJA_TILL_NUMBER
# Must be a public callback URL; production requires HTTPS
STK_CALLBACK_URL=https://YOUR-PUBLIC-BACKEND-DOMAIN/api/payments/callback
PUBLIC_BASE_URL=https://YOUR-PUBLIC-BACKEND-DOMAIN
