{
  "expo": {
    "name": "AlgoGuardian Alerts",
    "slug": "algoguardian-alerts",
    "scheme": "algoguardian-alerts",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.algoguardian.alerts",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "AlgoGuardian uses the camera to scan the one-time pairing QR code from your Windows PC."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "6528a36e-796e-40e4-97cc-c94c944ea7c1"
      }
    }
  }
}
