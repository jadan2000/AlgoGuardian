{
  "expo": {
    "name": "AlgoGuardian Alerts",
    "slug": "algoguardian-alerts",
    "scheme": "algoguardian-alerts",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.algoguardian.alerts",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "AlgoGuardian uses the camera to scan the one-time pairing QR code from your Windows PC."
        }
      ],
      "expo-notifications"
    ],
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "barStyle": "dark-content",
      "backgroundColor": "#F5F3ED"
    }
  }
}
